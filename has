    </div>

    <script>
        // Auto scroll ke bawah
        const output = document.getElementById('output');
        output.scrollTop = output.scrollHeight;

        // Focus input
        const input = document.getElementById('cmdInput');
        input.focus();

        // History navigasi dengan arrow keys
        const history = <?= json_encode(array_column($_SESSION['history'], 'cmd')) ?>;
        let histIndex = history.length;
        
        input.addEventListener('keydown', function(e) {
            if (e.key === 'ArrowUp') {
                e.preventDefault();
                if (histIndex > 0) {
                    histIndex--;
                    this.value = history[histIndex];
                }
            } else if (e.key === 'ArrowDown') {
                e.preventDefault();
                if (histIndex < history.length - 1) {
                    histIndex++;
                    this.value = history[histIndex];
                } else {
                    histIndex = history.length;
                    this.value = '';
                }
            }
        });

        // Keep focus on input saat klik di mana saja
        document.addEventListener('click', function(e) {
            if (e.target.tagName !== 'BUTTON' && e.target.tagName !== 'INPUT') {
                input.focus();
            }
        });

        // Auto submit saat Enter (default form behavior sudah ok)
    </script>
