        foreach ($_SESSION['history'] as $h) {
            echo '<span class="cmd-line">' . htmlspecialchars($h['cmd']) . "</span>\n";
            if ($h['output']) {
                // Highlight stderr & exit
                $out = htmlspecialchars($h['output']);
                $out = preg_replace('/\[STDERR\]/', '<span class="stderr">[STDERR]</span>', $out);
                $out = preg_replace('/\[Exit: (\d+)\]/', '<span class="exit">[Exit: $1]</span>', $out);
                echo $out . "\n\n";
            }
        }
