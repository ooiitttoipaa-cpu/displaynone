            `${driftDuration.toFixed(2)}s`,
          );

          fallingCoin.style.setProperty(
            "--drift-delay",
            `${driftDelay.toFixed(2)}s`,
          );

          fallingCoin.style.setProperty(
            "--drift-distance",
            `${random(8, 42).toFixed(1)}px`,
          );

          fallingCoin.style.setProperty(
            "--tilt-x",
            `${random(-18, 18).toFixed(1)}deg`,
