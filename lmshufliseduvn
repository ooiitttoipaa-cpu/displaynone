    */
          fallingCoin.style.left = `${((index / totalCoins) * 100 + random(-4, 4)).toFixed(2)}%`;

          rotationWrapper.appendChild(image);
          driftWrapper.appendChild(rotationWrapper);
          fallingCoin.appendChild(driftWrapper);

          return fallingCoin;
        }

        function generateCoins() {
          container.innerHTML = "";

          /*
      Desktop dibuat cukup ramai tetapi tetap elegan.
      Mobile memakai jumlah lebih sedikit agar ringan.
    */
          const screenWidth = window.innerWidth;

          let coinCount;

          if (screenWidth < 480) {
            coinCount = 20;
          } else if (screenWidth < 768) {
            coinCount = 28;
          } else if (screenWidth < 1200) {
            coinCount = 38;
          } else {
            coinCount = 46;
          }

          const fragment = document.createDocumentFragment();

          for (let i = 0; i < coinCount; i++) {
            fragment.appendChild(createCoin(i, coinCount));
          }

          container.appendChild(fragment);
        }

        generateCoins();

        window.addEventListener("resize", () => {
          clearTimeout(resizeTimer);

          resizeTimer = setTimeout(() => {
            generateCoins();
          }, 250);
        });
      })();
