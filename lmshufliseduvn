        let resizeTimer = null;

        function random(min, max) {
          return Math.random() * (max - min) + min;
        }

        function randomInteger(min, max) {
          return Math.floor(random(min, max + 1));
        }

        function createCoin(index, totalCoins) {
          const fallingCoin = document.createElement("div");
          const driftWrapper = document.createElement("div");
          const rotationWrapper = document.createElement("div");
          const image = document.createElement("img");

          fallingCoin.className = "falling-coin";
          driftWrapper.className = "coin-drift";
          rotationWrapper.className = "coin-rotation";
          image.className = "coin-image";

          image.src = coinImagePath;
          image.alt = "";
          image.draggable = false;
          image.decoding = "async";

          /*
      Menentukan kedalaman setiap koin.
      Koin latar lebih kecil, redup, dan sedikit blur.
      Koin depan lebih besar dan tajam.
    */
          const depthType = Math.random();

          let size;
          let opacity;
          let brightness;
          let depth;
          let layerClass;

          if (depthType < 0.28) {
            size = random(18, 30);
            opacity = random(0.28, 0.48);
            brightness = random(0.76, 0.9);
            depth = random(-220, -90);
            layerClass = "coin-background";
          } else if (depthType > 0.82) {
            size = random(48, 76);
            opacity = random(0.82, 1);
            brightness = random(1, 1.12);
            depth = random(40, 140);
            layerClass = "coin-foreground";
          } else {
            size = random(28, 48);
            opacity = random(0.58, 0.86);
            brightness = random(0.88, 1.04);
            depth = random(-60, 50);
            layerClass = "coin-middle";
          }

          fallingCoin.classList.add(layerClass);

          /*
      Posisi awal dan arah jatuh.
    */
          const startPosition = random(-5, 100);
          const horizontalMovement = random(-8, 8);

          /*
      Koin besar dibuat jatuh sedikit lebih cepat.
    */
          const fallDuration =
            layerClass === "coin-foreground"
              ? random(5.8, 8)
              : layerClass === "coin-background"
                ? random(10, 15)
                : random(7.5, 11.5);

          const spinDuration = random(1.8, 4.5);
          const driftDuration = random(2.8, 6.5);

          /*
      Delay negatif membuat koin langsung memenuhi layar
