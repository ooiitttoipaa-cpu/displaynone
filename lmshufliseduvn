          const fallDelay = random(-fallDuration, 0);
          const spinDelay = random(-spinDuration, 0);
          const driftDelay = random(-driftDuration, 0);

          fallingCoin.style.setProperty("--coin-size", `${size.toFixed(1)}px`);

          fallingCoin.style.setProperty("--coin-opacity", opacity.toFixed(2));

          fallingCoin.style.setProperty(
            "--coin-brightness",
            brightness.toFixed(2),
          );

          fallingCoin.style.setProperty(
            "--start-x",
            `${startPosition.toFixed(2)}vw`,
          );

          fallingCoin.style.setProperty(
            "--end-x",
            `${(startPosition + horizontalMovement).toFixed(2)}vw`,
          );

          fallingCoin.style.setProperty("--depth", `${depth.toFixed(0)}px`);

          fallingCoin.style.setProperty(
            "--fall-duration",
            `${fallDuration.toFixed(2)}s`,
          );

          fallingCoin.style.setProperty(
